// 量化回测系统 Prisma Schema
// 模型：ETF、关联关系、持仓、日K、subscribeShare 原始快照、同步任务状态

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// ETF基础信息
model Etf {
  code          String   @id
  name          String
  trackingIndex String
  trackIndex    String?
  scale         Float?
  updatedAt     DateTime @updatedAt

  @@map("etf")
}

/// ETF关联关系
model LinkEtf {
  target    String
  source    String
  similar   Float?
  updatedAt DateTime @updatedAt

  @@id([target, source])
  @@index([source])
  @@map("linkEtf")
}

/// ETF持仓
model EtfHolding {
  etfCode      String
  securityCode String
  name         String
  holdScale    Float
  updatedAt    DateTime @updatedAt

  @@id([etfCode, securityCode])
  @@map("etfHolding")
}

/// 日K线数据
model Kline {
  code          String
  date          Int
  preClose      Float
  open          Float
  high          Float
  low           Float
  close         Float
  volume        Float
  amount        Float
  change        Float
  changePercent Float
  source        String
  updatedAt     DateTime @updatedAt

  @@id([code, date])
  @@index([code, source, date])
  @@map("kline")
}

/// 复权因子（稀疏：仅在上市首日与除权除息日各一行）
/// 后复权价 = kline 原始价 * 当日生效的 factor，早于首条记录时 factor 为 1
model EtfAdjustFactor {
  code      String
  date      Int
  factor    Float
  updatedAt DateTime @updatedAt

  @@id([code, date])
  @@map("etfAdjustFactor")
}

/// 每日份额：份额 * 收盘价 即当日规模，份额环比变化即申赎资金流
model EtfFloatShare {
  code      String
  date      Int
  shares    Float
  updatedAt DateTime @updatedAt

  @@id([code, date])
  @@map("etfFloatShare")
}

/// subscribeShare 原始快照：每只 ETF 一行，存最近一次抓到的原始响应
model SubscribeShareSnapshot {
  code    String @id
  payload String

  @@map("subscribeShareSnapshot")
}

/// 同步任务状态：每个任务一行，形如 day_kv2:513050.SH
model SyncTask {
  taskKey   String   @id
  /// success | failed
  status    String
  /// 失败原因，success 时为 null
  error     String?
  /// 上次运行（写库）时间：success 靠它判断是否已经跨交易日（交易日历见 crawler）
  updatedAt DateTime @updatedAt

  @@map("syncTask")
}
