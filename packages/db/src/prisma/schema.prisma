generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// ETF基础信息
model Etf {
  code        String  @id
  name        String
  indexCode   String
  indexName   String?
  premiumRate Float?
  // 分类
  category    String

  scale Float

  @@map("etfs")
}

/// ETF关联关系
model Link {
  target  String
  source  String
  similar Float?

  @@id([target, source])
  @@map("links")
}

/// ETF持仓
model Holding {
  code      String
  stockCode String
  stockName String
  holdScale Float

  @@id([code, stockCode])
  @@map("holdings")
}

/// 日K线数据
model Kline {
  code          String
  // 格式：YYYYMMDD
  date          Int
  open          Float
  high          Float
  low           Float
  close         Float
  volume        Float
  amount        Float
  change        Float
  changePercent Float

  @@id([code, date])
  @@map("klines")
}

/// 指数估值
model Valuation {
  indexCode String
  // type: "PE" | "PB" | "PS"
  type      String
  date      Int
  value     Float
  percent   Float?
  peg       Float?

  @@id([indexCode, type, date])
  @@index([indexCode, type, date])
  @@map("valuations")
}

/// 指数申万行业权重：level 1 / 2 / 3
model Sw {
  indexCode    String
  level        Int
  industryCode String
  industryName String
  weight       Float

  @@id([indexCode, level, industryCode])
  @@index([indexCode, level, weight])
  @@map("sws")
}

/// 同步任务状态：每个任务一行，形如 day_kv2:513050.SH
model Task {
  name      String   @id
  /// success | failed
  status    String
  /// 失败原因，success 时为 null
  error     String?
  /// 上次运行（写库）时间：success 靠它判断是否已经跨交易日（交易日历见 crawler）
  updatedAt DateTime @updatedAt

  @@map("tasks")
}
