generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// ETF基础信息
model Etf {
  code        String  @id
  name        String
  indexCode   String
  indexName   String?
  premiumRate Float?
  // 分类
  category    String

  scale Float?

  @@map("etfs")
}

/// ETF关联关系
model LinkEtf {
  target  String
  source  String
  similar Float?

  @@id([target, source])
  @@map("linkEtfs")
}

/// ETF持仓
model EtfHolding {
  etfCode      String
  securityCode String
  name         String
  holdScale    Float

  @@id([etfCode, securityCode])
  @@map("etfHolding")
}

/// 日K线数据
model Kline {
  code          String
  // 格式：YYYYMMDD
  date          Int
  open          Float
  high          Float
  low           Float
  close         Float
  volume        Float
  amount        Float
  change        Float
  changePercent Float

  @@id([code, date])
  @@map("kline")
}

/// 指数估值时序：pe / pb / psTtm / indexGZPer
model EtfValuation {
  indexCode  String
  metric     String
  date       Int
  value      Float
  /// pe / pb / psTtm 的历史分位，indexGZPer 为 null
  percentile Float?

  @@id([indexCode, metric, date])
  @@index([indexCode, metric, date])
  @@map("etfValuation")
}

/// 每个指数估值指标一行，保存该指标返回的 min / max / mid 范围
model EtfValuationMetric {
  indexCode String
  metric    String
  min       Float?
  max       Float?
  mid       Float?

  @@id([indexCode, metric])
  @@map("etfValuationMetric")
}

/// 指数申万行业权重：level 1 / 2 / 3
model IndexSwIndustry {
  indexCode    String
  level        Int
  industryCode String
  name         String
  weight       Float

  @@id([indexCode, level, industryCode])
  @@index([indexCode, level, weight])
  @@map("indexSwIndustry")
}

/// 同步任务状态：每个任务一行，形如 day_kv2:513050.SH
model SyncTask {
  taskKey   String   @id
  /// success | failed
  status    String
  /// 失败原因，success 时为 null
  error     String?
  /// 上次运行（写库）时间：success 靠它判断是否已经跨交易日（交易日历见 crawler）
  updatedAt DateTime @updatedAt

  @@map("syncTask")
}
