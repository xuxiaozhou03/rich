// 量化回测系统 Prisma Schema
// 模型：ETF、关联关系、持仓、日K、subscribeShare 原始快照、同步任务状态

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// ETF基础信息
model Etf {
  code          String   @id
  name          String
  trackingIndex String
  trackIndex    String?
  scale         Float?
  updatedAt     DateTime @updatedAt

  @@map("etf")
}

/// ETF关联关系
model LinkEtf {
  target    String
  source    String
  similar   Float?
  updatedAt DateTime @updatedAt

  @@id([target, source])
  @@index([source])
  @@map("linkEtf")
}

/// ETF持仓
model EtfHolding {
  etfCode      String
  securityCode String
  name         String
  holdScale    Float
  updatedAt    DateTime @updatedAt

  @@id([etfCode, securityCode])
  @@map("etfHolding")
}

/// 日K线数据
model Kline {
  code          String
  date          Int
  preClose      Float
  open          Float
  high          Float
  low           Float
  close         Float
  volume        Float
  amount        Float
  change        Float
  changePercent Float
  source        String
  updatedAt     DateTime @updatedAt

  @@id([code, date])
  @@index([code, source, date])
  @@map("kline")
}

/// subscribeShare 原始快照
model SubscribeShareSnapshot {
  id             String   @id @default(cuid())
  code           String
  latestDate     Int
  payload        String
  payloadHash    String
  firstFetchedAt DateTime @default(now())
  lastFetchedAt  DateTime @default(now())
  lastSeenAt     DateTime @default(now())

  @@unique([code, latestDate])
  @@index([code, latestDate])
  @@map("subscribeShareSnapshot")
}

/// 同步任务状态
model SyncTask {
  taskKey             String    @id
  status              String
  resultCode          String?
  runId               String?
  expiresAt           DateTime?
  nextRetryAt         DateTime?
  lockedUntil         DateTime?
  lastStartedAt       DateTime?
  lastFinishedAt      DateTime?
  lastSuccessAt       DateTime?
  lastErrorAt         DateTime?
  errorType           String?
  errorMessage        String?
  consecutiveFailures Int       @default(0)
  updatedAt           DateTime  @updatedAt

  @@index([status, expiresAt])
  @@map("syncTask")
}
